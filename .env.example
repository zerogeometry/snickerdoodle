# Copy to .env and fill in. NEVER commit the real .env.
#
# Postgres — UK/EU region (e.g. AWS eu-west-2 / London) in production.
# For local dev, `docker compose up -d` starts one on host port 5544 with these
# throwaway credentials; then `npm run db:migrate` applies the schema:
DATABASE_URL=postgres://snickerdoodle:localdev@localhost:5544/snickerdoodle
