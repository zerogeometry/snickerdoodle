# Copy to .env and fill in. NEVER commit the real .env.
#
# Postgres — UK/EU region (e.g. AWS eu-west-2 / London) in production.
# For local dev, `docker compose up -d` starts one on host port 5544 with these
# throwaway credentials; then `npm run db:migrate` applies the schema:
DATABASE_URL=postgres://snickerdoodle:localdev@localhost:5544/snickerdoodle

# Auth.js — secret used to sign the session cookie + CSRF token.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=generate-a-strong-random-secret

# Private object storage. Local dev uses MinIO (docker compose up -d); in
# production point these at the UK/EU private bucket (e.g. AWS S3 eu-west-2)
# with KMS at-rest encryption. The bucket must never have a public policy.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-2
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=snickerdoodle-originals
S3_FORCE_PATH_STYLE=true
