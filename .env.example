# Copy to .env and fill in. NEVER commit the real .env.
#
# Postgres — UK/EU region (e.g. AWS eu-west-2 / London) in production.
# For local dev, `docker compose up -d` starts one on host port 5544 with these
# throwaway credentials; then `npm run db:migrate` applies the schema:
DATABASE_URL=postgres://snickerdoodle:localdev@localhost:5544/snickerdoodle

# Auth.js — secret used to sign the session cookie + CSRF token.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=generate-a-strong-random-secret
# The canonical URL magic links + auth redirects are built on. Pin it so they
# don't depend on the server bind host (binding 0.0.0.0 otherwise yields
# unreachable 0.0.0.0 links). In production set it to the real https origin.
AUTH_URL=http://localhost:3000

# Private object storage. Local dev uses MinIO (docker compose up -d); in
# production point these at the UK/EU private bucket (e.g. AWS S3 eu-west-2)
# with KMS at-rest encryption. The bucket must never have a public policy.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-2
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=snickerdoodle-originals
S3_FORCE_PATH_STYLE=true
# Direct uploads: the browser PUTs a drawing/photo straight to the private bucket on a
# 5-minute, single-key, size-pinned URL; the server then checks it (EXIF strip, CSAM hash,
# moderation) before it becomes a draft. Needs the bucket's CORS to allow the site's PUT
# (project-office/ops/DIRECT-UPLOADS.md). Local MinIO allows any origin, so dev can turn it on.
# Off ⇒ uploads go through the Server Action body (capped at 6MB on Netlify).
S3_DIRECT_UPLOADS=true

# Payments (Stripe, test mode). With these UNSET, checkout uses a local "mark
# paid" fallback so the order flow is walkable without keys. Set them to take
# real (test) card payments; point the Stripe webhook at /api/webhooks/stripe.
APP_URL=http://localhost:3000
# STRIPE_SECRET_KEY=sk_test_xxx          # Dashboard → Developers → API keys (TEST)
# STRIPE_WEBHOOK_SECRET=whsec_xxx        # from: stripe listen --forward-to localhost:3000/api/webhooks/stripe

# Prodigi (print-on-demand). SANDBOX while building: the catalogue sync + sandbox
# test-orders run against this. The LIVE hand-off of a child's image stays gated at a
# single chokepoint until LG3 + LG6 (content-safety live + a signed Article 28 DPA).
# Key: Prodigi dashboard → Settings → API.
# PRODIGI_API_KEY=your-sandbox-api-key
PRODIGI_BASE_URL=https://api.sandbox.prodigi.com/v4.0   # live: https://api.prodigi.com/v4.0
# Child-image POD egress is HARD-GATED in code (src/fulfillment/gate.ts) — a server-side,
# asset-aware predicate, NOT a single flag. It stays SANDBOX (child images never leave,
# even to sandbox) until BOTH: a signed Prodigi Article 28 DPA exists in the sub_processors
# register (LG6) AND the LG3 transfer-risk assessment is signed off. Defaults are safe.
# POD_MODE=SANDBOX                          # set to LIVE only when going live
# LG3_TRANSFER_ASSESSMENT_SIGNED_OFF=true   # set ONLY by the documented DP sign-off

# Content safety (D8). The stub passes everything CLEAR for local dev. Set to "real"
# to enable the IWF hash-check + AWS Rekognition classifier (needs their credentials).
# MODERATION_PROVIDER=stub

# Shared secret for cron-triggered jobs. Schedule a daily POST to
# /api/jobs/retention with header "Authorization: Bearer <JOBS_SECRET>".
JOBS_SECRET=generate-a-strong-random-secret
