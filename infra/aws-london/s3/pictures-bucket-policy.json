{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyAnythingNotOverTLS",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::PICTURES_BUCKET",
        "arn:aws:s3:::PICTURES_BUCKET/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "QuarantineMustUseOriginalsKey",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::PICTURES_BUCKET/quarantine/*",
      "Condition": {
        "StringNotEquals": {
          "s3:x-amz-server-side-encryption-aws-kms-key-id": "ORIGINALS_KEY_ARN"
        }
      }
    }
  ]
}
