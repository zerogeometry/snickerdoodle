# This box's own settings — NOT secrets. Copy to /etc/snickerdoodle/box.env on the box
# (bin/bootstrap-box.sh does it) and fill in. Read by every script in bin/ and by docker compose.

# AWS region for everything (S3, KMS, SSM, ECR, Rekognition, logs)
AWS_REGION=eu-west-2
# the AWS CLI profile in /root/.aws/credentials holding the `snickerdoodle-box` user's key (runbook §3.5)
AWS_PROFILE=snickerdoodle-box
# where the app's settings live in SSM Parameter Store (trailing slash)
SSM_PATH=/snickerdoodle/prod/

# the image repository in ECR (private, eu-west-2)
IMAGE_REPO=123456789012.dkr.ecr.eu-west-2.amazonaws.com/snickerdoodle

# the site, and the email Let's Encrypt writes to about certificates
SITE_DOMAIN=snickerdoodle.co.uk
ACME_EMAIL=hello@snickerdoodle.co.uk

# Database: leave empty for the Lightsail managed database (recommended),
# or set to local-db to run Postgres on this box.
COMPOSE_PROFILES=

# nightly database dumps (bin/backup-db.sh): the backups bucket and the GENERAL KMS key's ARN
BACKUP_BUCKET=snickerdoodle-db-backups-123456789012
BACKUP_KMS_KEY=arn:aws:kms:eu-west-2:123456789012:key/00000000-0000-0000-0000-000000000000

# an SNS topic (eu-west-2) that emails the founder: deploy failures, auto-rollbacks, backup failures.
# Leave empty to only log them.
ALERT_TOPIC_ARN=

# resource caps (defaults suit the 4 vCPU / 8 GB compute-optimised plan)
APP_MEM_LIMIT=5g
APP_CPUS=3.5
APP_NODE_HEAP_MB=2560
DB_MEM_LIMIT=1500m

# images for the helpers (pinned; change only on purpose)
CADDY_IMAGE=caddy:2.10-alpine
SCHEDULER_IMAGE=alpine:3.22
POSTGRES_IMAGE=postgres:16-bookworm
