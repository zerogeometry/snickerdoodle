# ─────────────────────────────────────────────────────────────────────────────────────────────────
# Snickerdoodle — EVERY setting the app reads, for the AWS London box (D18).
#
# THIS FILE IS A LIST, NOT A PLACE FOR VALUES. Real values live in AWS SSM Parameter Store, one
# parameter each, under /snickerdoodle/prod/<NAME>  (eu-west-2):
#   [SECRET] → type SecureString (encrypted; the free aws/ssm key is fine)
#   [plain]  → type String
# bin/fetch-env.sh reads them into /run/snickerdoodle/app.env (memory only; readable by root and the
# app's own user id) at boot and on every deploy. The app reads that FILE at start (infra/start.mjs)
# — settings never travel as container environment, which Docker would keep on disk.
# Never put a value in this file, in git, or in chat.
#
# Create one with (founder's AWS account — runbook §3.6):
#   aws ssm put-parameter --region eu-west-2 --name /snickerdoodle/prod/AUTH_SECRET \
#     --type SecureString --value "$(openssl rand -base64 32)"
# Change one: same command + --overwrite, then `sudo /opt/snickerdoodle/kit/bin/deploy.sh --restart`.
#
# Values must be single-line. SSM Standard parameters (≤ 4 KB) are free.
# ─────────────────────────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────────────────────────
# [SECRET] Postgres. Lightsail managed DB (recommended) — verify-full: the database's certificate
# is CHECKED against the Amazon RDS CA bundle the bootstrap installs (never just "encrypted"):
#   postgres://snickerdoodle:<password>@<endpoint>.eu-west-2.rds.amazonaws.com:5432/snickerdoodle?sslmode=verify-full
# On-box DB (COMPOSE_PROFILES=local-db): postgres://snickerdoodle:<LOCAL_DB_PASSWORD>@db:5432/snickerdoodle
DATABASE_URL=
# [SECRET] signs session cookies, CSRF tokens and upload claims. ≥ 32 chars: openssl rand -base64 32
AUTH_SECRET=
# [plain] the canonical https origin magic links and redirects are built on
AUTH_URL=https://snickerdoodle.co.uk
# [plain] the same origin, for links in emails, Stripe return URLs and gift links
APP_URL=https://snickerdoodle.co.uk
# [SECRET] the shared secret the scheduler sends to /api/jobs/*. openssl rand -base64 32
JOBS_SECRET=
# [plain] the ONE header the rate limits trust for the visitor's address. Caddy overwrites
# X-Real-IP on every request, so on the box: x-real-ip (anything a visitor sends is then ignored)
CLIENT_IP_HEADER=x-real-ip

# ── Private picture storage: S3 eu-west-2 (runbook §3.3) ─────────────────────────────────────────
# [plain] leave S3_ENDPOINT and S3_FORCE_PATH_STYLE UNSET on AWS (they're for MinIO / Supabase)
S3_REGION=eu-west-2
# [plain] the private pictures bucket
S3_BUCKET=
# [SECRET] the access key of the IAM user `snickerdoodle-app` (runbook §3.5). Lightsail can't
# attach an IAM role, so the app uses this one least-privilege user's key. Rotate every 90 days.
S3_ACCESS_KEY=
# [SECRET]
S3_SECRET_KEY=
# [plain] the GENERAL KMS key — use the key ARN (arn:aws:kms:eu-west-2:<acct>:key/<id>)
S3_KMS_KEY_ALIAS=
# [plain] the ORIGINALS KMS key (a different key) — key ARN. Production refuses to store without it.
S3_KMS_KEY_ALIAS_ORIGINALS=
# [plain] browser → bucket uploads. Set to true only after the bucket CORS rule is in (runbook §3.3)
S3_DIRECT_UPLOADS=
# [SECRET] the SAME snickerdoodle-app key again, under the names the AWS SDK's standard chain reads:
# Rekognition (content safety, src/server/moderation) uses them. Required once MODERATION_PROVIDER=real.
AWS_ACCESS_KEY_ID=
# [SECRET]
AWS_SECRET_ACCESS_KEY=

# ── Email (decision D7 still open) ───────────────────────────────────────────────────────────────
# [plain] "resend" today (the only adapter). Production refuses to start sending without one.
MAIL_PROVIDER=resend
# [plain] e.g. snickerdoodle <hello@mail.snickerdoodle.co.uk> — on the domain verified with the provider
MAIL_FROM=
# [SECRET] Resend (EU region) API key, while MAIL_PROVIDER=resend
RESEND_API_KEY=
# [plain] where "see / download / delete my data" requests are copied to
PRIVACY_INBOX=
# [plain] where help messages and content reports go (default support@snickerdoodle.co.uk)
SUPPORT_INBOX=
# [plain] who packs the hand-made parts of an order (gift wrap), comma-separated (default SUPPORT_INBOX)
ORDER_ALERT_EMAILS=

# ── Payments: Stripe (server-side totals; card data never touches us) ──────────────────────────
# [SECRET] sk_test_… until launch; sk_live_… only at go-live (LG gates closed)
STRIPE_SECRET_KEY=
# [SECRET] Stripe → Developers → Webhooks → https://<domain>/api/webhooks/stripe → signing secret
STRIPE_WEBHOOK_SECRET=

# ── Print-on-demand: Prodigi ─────────────────────────────────────────────────────────────────────
# [SECRET]
PRODIGI_API_KEY=
# [plain] sandbox until go-live: https://api.sandbox.prodigi.com/v4.0 · live: https://api.prodigi.com/v4.0
PRODIGI_BASE_URL=https://api.sandbox.prodigi.com/v4.0
# [plain] SANDBOX until go-live. LIVE alone does nothing: the egress gate (src/fulfillment/gate.ts)
# also needs the LG3 sign-off and a Prodigi DPA row in the sub-processor register.
POD_MODE=SANDBOX
# [plain] DO NOT CREATE this parameter until the DP professional signs off the LG3 transfer
# assessment. Then: true.
# LG3_TRANSFER_ASSESSMENT_SIGNED_OFF=

# ── Content safety (D8) ──────────────────────────────────────────────────────────────────────────
# [plain] "real" turns on IWF hash-matching + Rekognition (eu-west-2 only). Leave UNSET until LG6 is
# green and the AWS AI-services opt-out is recorded (runbook §3.1). Until IWF is onboarded, "real"
# still holds EVERY upload for review (the hash gate is closed). Needs AWS_ACCESS_KEY_ID/SECRET above.
# MODERATION_PROVIDER=

# ── Magic-edit budget caps (optional; defaults shown) ────────────────────────────────────────────
# [plain]
# ML_BUDGET_PER_CREATION=20
# ML_BUDGET_PER_ACCOUNT=500

# ── Test-site mode (only for a password-locked STAGING copy on a box — never the real shop) ────
# [plain] "test" = banner, password lock, never indexed, refuses live keys. UNSET for the real shop.
# SITE_MODE=
# [SECRET] only with SITE_MODE=test: the shared password (10+ chars)
# TEST_SITE_PASSWORD=

# ── On-box database only (COMPOSE_PROFILES=local-db) ─────────────────────────────────────────────
# [SECRET] the on-box Postgres password; fetch-env.sh writes it to its own file for the db
# container and keeps it OUT of the app's settings. Hex, so it's URL-safe: openssl rand -hex 24
# LOCAL_DB_PASSWORD=

# ── Set by the image or compose — do NOT create parameters for these ────────────────────────────
# NODE_ENV=production · PORT=3000 · HOSTNAME=0.0.0.0 · APP_BUILD=<image tag> · NODE_OPTIONS ·
# NODE_EXTRA_CA_CERTS · HOME · SNICKERDOODLE_REQUIRE_SECRETS (start-time settings, set by compose)
#
# ── Developer / test tooling only — must NEVER be set on the box ────────────────────────────────
# S3_ENDPOINT, S3_FORCE_PATH_STYLE (MinIO/Supabase), DEV_UPLOADS_ARE_BRAND_SAFE_FIXTURES,
# NEXT_DIST_DIR, GALLERY_OUT, PARITY_REPORT, UPDATE_PARITY, PRODIGI_LIVE_CHECK, SEED_VERBOSE,
# and ANY AWS_ENDPOINT_URL* (it would redirect S3 / Rekognition calls away from AWS London).
# fetch-env.sh refuses to start if it finds any of S3_ENDPOINT, S3_FORCE_PATH_STYLE,
# DEV_UPLOADS_ARE_BRAND_SAFE_FIXTURES, NEXT_DIST_DIR or an AWS_ENDPOINT_URL*.
