# 02:30 UTC every night (quiet hours; before the 03:15 retention job). Persistent: a night the box
# was off is caught up at the next boot.
[Unit]
Description=Nightly Snickerdoodle database backup

[Timer]
OnCalendar=*-*-* 02:30:00 UTC
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
